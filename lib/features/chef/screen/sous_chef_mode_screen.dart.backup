  // 믹싱 단계 분석 카드
  Widget _buildMixingStageAnalysisCard() {
    // 발효 방식에 따른 환경 데이터 적용
    final environmentData = _getEnvironmentDataForFermentation();

    final inputs = {
      'temperature': environmentData['temperature'],
      'humidity': environmentData['humidity'],
      'altitude': environmentData['altitude'],
      'season': environmentData['season'],
      'mixerType': environmentData['mixerType'],
      'fermentationMethod': _currentEnvironment.fermentationMethod.name,
      'ovenType': _currentEnvironment.ovenType.name,
    };

    // 실제 믹싱 데이터 가져오기 (헬퍼 클래스 사용)
    final mixingData =
        MixingDataHelper.ensureMixingDataExists(widget.recipeData);

    // 새로운 모듈화된 시스템 객체들 생성 (선택사항)
    final newEnvironment = _convertToNewEnvironmentalConditions();

    // 믹서 타입 변경 시 강제로 리빌드하기 위한 key 생성
    final mixerTypeKey =
        '${inputs['mixerType']}_${DateTime.now().millisecondsSinceEpoch ~/ 1000}';

    // 새로운 통합 믹싱 분석 카드로 변환 - RecipeConverter 사용
    final unifiedRecipe = RecipeConverter.fromLegacy(widget.recipeData);

    // 타입 안전성을 위해 추가 체크
    if (unifiedRecipe == null) {
      return const Card(
        child: Padding(
          padding: EdgeInsets.all(16),
          child: Text('레시피 데이터를 변환할 수 없습니다.'),
        ),
      );
    }

    final breadUserData = _createBreadUserDataFromLegacy(inputs, mixingData);

    return MixingAnalysisCard(
      key: ValueKey(mixerTypeKey), // 믹서 타입 변경 시 강제 리빌드
      recipeData: widget.recipeData, // 원본 레시피 데이터 사용
      environment: _currentEnvironment, // 현재 환경 설정 사용
      settings: AnalysisSettings(
        enableRPMMode: true,
        enableEffectsVisualization: true,
        enableRealTimeFeedback: true,
      ), // 분석 설정
    );
  }

  // 레시피에서 믹싱 데이터 추출 (헬퍼 클래스 사용)
  List<Map<String, dynamic>> _getMixingDataFromRecipe() {
    return MixingDataHelper.getMixingDataFromRecipe(widget.recipeData);
  }

  // 발효 방식에 따른 환경 데이터 반환
  Map<String, dynamic> _getEnvironmentDataForFermentation() {
    final method = _currentEnvironment.fermentationMethod;
    final mixerData = _getMixerData();

    switch (method) {
      case FermentationMethod.roomTemperature:
        return {
          'temperature': _currentEnvironment.temperature,
          'humidity': _currentEnvironment.humidity,
          'altitude': _currentEnvironment.altitude,
          'season': _currentEnvironment.season.displayName,
          'mixerType': _currentEnvironment.mixerType.name,
          'mixerRPMProfile': mixerData['rpmProfile'],
          'mixerEfficiency': mixerData['efficiency'],
        };

      case FermentationMethod.overnight:
        return {
          'temperature': 4.0,
          'humidity': 85.0,
          'altitude': _currentEnvironment.altitude,
          'season': _currentEnvironment.season.displayName,
          'mixerType': _currentEnvironment.mixerType.name,
          'mixerRPMProfile': mixerData['rpmProfile'],
          'mixerEfficiency': mixerData['efficiency'],
        };

      case FermentationMethod.fermenter:
        return {
          'temperature': _getFermenterTemperatureForStage(),
          'humidity': _getFermenterHumidityForStage(),
          'altitude': _currentEnvironment.altitude,
          'season': _currentEnvironment.season.displayName,
          'mixerType': _currentEnvironment.mixerType.name,
          'mixerRPMProfile': mixerData['rpmProfile'],
          'mixerEfficiency': mixerData['efficiency'],
        };

      case FermentationMethod.natural:
        return {
          'temperature': _currentEnvironment.temperature,
          'humidity': _currentEnvironment.humidity,
          'altitude': _currentEnvironment.altitude,
          'season': _currentEnvironment.season.displayName,
          'mixerType': _currentEnvironment.mixerType.name,
          'mixerRPMProfile': mixerData['rpmProfile'],
          'mixerEfficiency': mixerData['efficiency'],
        };

      default:
        return {
          'temperature': _currentEnvironment.temperature,
          'humidity': _currentEnvironment.humidity,
          'altitude': _currentEnvironment.altitude,
          'season': _currentEnvironment.season.displayName,
          'mixerType': _currentEnvironment.mixerType.name,
          'mixerRPMProfile': mixerData['rpmProfile'],
          'mixerEfficiency': mixerData['efficiency'],
        };
    }
  }

