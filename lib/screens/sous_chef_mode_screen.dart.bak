  void _onPresetSelected(FavoritePreset preset) {
    // 프리셋 선택 시 처리 로직
    setState(() {
      _selectedFavoritePreset = preset;
      _showFeedbackSection = true;
      _feedbackCompleted = false;
    });

    // 프리셋 기반 최적화 실행
    _applyPresetOptimization(preset);

    // 성공 메시지 표시
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('${preset.name} 프리셋이 적용되었습니다'),
        backgroundColor: Colors.green.shade600,
        action: SnackBarAction(
          label: '분석 보기',
          textColor: Colors.white,
          onPressed: () {
            // 분석 탭으로 이동
            _tabController.animateTo(0);
          },
        ),
      ),
    );
  }

  void _applyPresetOptimization(FavoritePreset preset) {
    // 프리셋 기반 최적화 로직
    // 실제로는 프리셋의 설정을 현재 레시피에 적용하는 복잡한 로직이 필요
    
    // 예시: 환경 조건 업데이트
    if (preset.environmentalConditions.containsKey('temperature')) {
      _temperatureController.text = preset.environmentalConditions['temperature'].toString();
    }
    if (preset.environmentalConditions.containsKey('humidity')) {
      _humidityController.text = preset.environmentalConditions['humidity'].toString();
    }
    if (preset.environmentalConditions.containsKey('altitude')) {
      _altitudeController.text = preset.environmentalConditions['altitude'].toString();
    }

    // 재분석 실행
    _performOptimization();
  }

  void _showFeedbackDialog() {
    if (_selectedFavoritePreset == null) {
      _showErrorDialog('프리셋이 선택되지 않았습니다.');
      return;
    }

    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (context) => Dialog(
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(16),
        ),
        child: Container(
          constraints: const BoxConstraints(
            maxWidth: 500,
            maxHeight: 600,
          ),
          child: BakingResultFeedbackSimple(
            preset: _selectedFavoritePreset!,
            recipeContext: {
              'recipe_title': widget.recipeData['recipeInfo']['title'],
              'category': widget.recipeData['recipeInfo']['category'],
              'ingredients_count': (widget.recipeData['currentIngredients'] as List).length,
              'environmental_conditions': _getEnvironmentalConditions(),
              'analysis_result': _analysisResult?.toJson(),
            },
            onFeedbackSubmitted: _onFeedbackCompleted,
          ),
        ),
      ),
    );
  }

  void _onFeedbackCompleted() {
    setState(() {
      _feedbackCompleted = true;
    });

    Navigator.of(context).pop(); // 다이얼로그 닫기

    // 성공 메시지 표시
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: const Text('피드백이 성공적으로 저장되었습니다!'),
        backgroundColor: Colors.green.shade600,
        action: SnackBarAction(
          label: '추천 업데이트',
          textColor: Colors.white,
          onPressed: _updateRecommendations,
        ),
      ),
    );
  }

