  Widget _buildPresetBasedTab() {
    return PresetSelectionWidget(
      selectedPreset: _selectedPreset,
      onPresetSelected: (preset) {
        setState(() => _selectedPreset = preset);
        _generateFromPreset(preset);
      },
    );
  }

  Widget _buildTextBasedTab() {
    return TextBasedRecipeGenerator(
      environmentalConditions: _getEnvironmentalConditions(),
      onRecipeGenerated: (result) => setState(() => _reverseRecipeResult = result),
    );
  }

  Map<String, dynamic> _getEnvironmentalConditions() {
    return {
      'temperature': double.tryParse(_temperatureController.text) ?? 26.0,
      'humidity': double.tryParse(_humidityController.text) ?? 60.0,
      'altitude': double.tryParse(_altitudeController.text) ?? 0.0,
      'ovenType': _selectedOvenType,
    };
  }

  /// 발효 모듈 입력 데이터 생성
  Map<String, dynamic> _getFermentationInputs() {
    return {
      'recipeData': widget.recipeData,
      'room_temperature': double.tryParse(_temperatureController.text) ?? 26.0,
      'room_humidity': double.tryParse(_humidityController.text) ?? 60.0,
      'altitude': double.tryParse(_altitudeController.text) ?? 0.0,
      'fermentation_temperature': (double.tryParse(_temperatureController.text) ?? 26.0) + 2.0,
      'fermentation_humidity': (double.tryParse(_humidityController.text) ?? 60.0) + 10.0,
      'fermentation_time': 90.0,
      'analysisResult': _analysisResult,
    };
  }

  /// 오븐 모듈 입력 데이터 생성
  Map<String, dynamic> _getOvenInputs() {
    return {
      'recipeData': widget.recipeData,
      'room_temperature': double.tryParse(_temperatureController.text) ?? 26.0,
      'room_humidity': double.tryParse(_humidityController.text) ?? 60.0,
      'altitude': double.tryParse(_altitudeController.text) ?? 0.0,
      'oven_temperature': 180.0, // 기본값
      'baking_time': 25.0, // 기본값
      'oven_type': _selectedOvenType,
      'pan_color': _selectedPanColor,
      'analysisResult': _analysisResult,
    };
  }

  void _performOptimization() async {
    if (_analysisResult == null) {
      _showErrorDialog('레시피 분석이 완료되지 않았습니다. 잠시 후 다시 시도해주세요.');
      return;
    }
    
    setState(() => _isOptimizing = true);

    try {
      final environmentalConditions = _getEnvironmentalConditions();
      
      // 발효 모듈 계산
      final fermentationInputs = _getFermentationInputs();
      final fermentationAdjustments = _fermentationModule.calculate(fermentationInputs);
      
      // 오븐 모듈 계산
      final ovenInputs = _getOvenInputs();
      final ovenAdjustments = _ovenModule.calculate(ovenInputs);
      
      // 통합된 환경 조건 생성
      final enhancedEnvironmentalConditions = {
        ...environmentalConditions,
        'fermentationAdjustments': fermentationAdjustments,
        'ovenAdjustments': ovenAdjustments,
        'fermentationSettings': {
          'temperature': (double.tryParse(_temperatureController.text) ?? 26.0) + 2.0,
          'humidity': (double.tryParse(_humidityController.text) ?? 60.0) + 10.0,
          'time': 90.0,
        },
        'ovenSettings': {
          'temperature': 180.0, // 기본값
          'time': 25.0, // 기본값
          'type': _selectedOvenType,
          'panColor': _selectedPanColor,
        },
      };
      
      final afterStatus = ProductStatusGenerator.generateStatus(
        analysisResult: _analysisResult!,
        bakingContext: widget.recipeData['bakingContext'] as Map<String, dynamic>? ?? {},
        environmentalConditions: enhancedEnvironmentalConditions,
      );

      setState(() {
        _afterStatus = afterStatus;
        _optimizationResult = {
          'environmentalConditions': enhancedEnvironmentalConditions,
          'beforeStatus': _beforeStatus,
          'afterStatus': afterStatus,
          'fermentationAdjustments': fermentationAdjustments,
          'ovenAdjustments': ovenAdjustments,
        };
      });
    } catch (e) {
      _showErrorDialog('최적화 중 오류가 발생했습니다: $e');
    } finally {
      setState(() => _isOptimizing = false);
    }
  }

  void _generateFromPreset(RecipePreset preset) async {
    try {
      final result = await ReverseRecipeEngine.generateFromPreset(
        presetId: preset.id,
        environmentalConditions: _getEnvironmentalConditions(),
        baseFlourWeight: 300.0,
      );
      setState(() => _reverseRecipeResult = result);
    } catch (e) {
      _showErrorDialog('Error generating recipe from preset: $e');
    }
  }

  void _applyAndReturn() async {
    Map<String, dynamic> resultToReturn = {};

    // 히스토리 저장
    await _saveToHistory();

    if (_optimizationResult != null) {
      resultToReturn = {
        'optimizationResult': _optimizationResult,
        'beforeStatus': _beforeStatus?.toJson(),
        'afterStatus': _afterStatus?.toJson(),
      };
    }

    if (_reverseRecipeResult != null) {
      resultToReturn.addAll({
        'optimizedIngredients': _reverseRecipeResult!.generatedIngredients,
        'optimizationNotes': _reverseRecipeResult!.optimizationNotes,
        'achievementScore': _reverseRecipeResult!.achievementScore,
        'bakersPercentages': _reverseRecipeResult!.bakersPercentages,
        'isReverseRecipe': true,
      });
    }

    Navigator.pop(context, resultToReturn);
  }

  /// 히스토리에 저장
  Future<void> _saveToHistory() async {
    try {
      final recipeInfo = widget.recipeData['recipeInfo'] as Map<String, dynamic>;
      final currentIngredients = widget.recipeData['currentIngredients'] as List<Map<String, dynamic>>;
      
      RecipeHistory? history;

      if (_optimizationResult != null && _beforeStatus != null && _afterStatus != null) {
        // 최적화 히스토리
        history = RecipeHistory.create(
          recipeTitle: recipeInfo['title'] ?? 'Unknown Recipe',
          recipeCategory: recipeInfo['category'] ?? 'General',
          type: RecipeHistoryType.optimization,
          originalIngredients: {'ingredients': currentIngredients},
          optimizedIngredients: _optimizationResult!,
          environmentalConditions: _getEnvironmentalConditions(),
          beforeStatus: ProductStatusHistory.fromProductStatus(_beforeStatus!),
          afterStatus: ProductStatusHistory.fromProductStatus(_afterStatus!),
          optimizationNotes: ['환경 조건에 따른 최적화 적용'],
        );
      } else if (_reverseRecipeResult != null) {
        // 역산 레시피 히스토리
        final beforeStatus = ProductStatusHistory(
          textureProfile: '기본',
          flavorProfile: ['기본'],
          appearanceProfile: '기본',
          textureScore: 0.6,
          flavorScore: 0.6,
          appearanceScore: 0.6,
          confidenceLevel: 0.5,
        );
        
        final afterStatus = ProductStatusHistory(
          textureProfile: _reverseRecipeResult!.predictedStatus.textureProfile.primary,
          flavorProfile: _reverseRecipeResult!.predictedStatus.flavorProfile.primary,
          appearanceProfile: _reverseRecipeResult!.predictedStatus.appearanceProfile.crustColor,
          textureScore: 0.8,
          flavorScore: 0.8,
          appearanceScore: 0.8,
          confidenceLevel: _reverseRecipeResult!.achievementScore,
        );

        history = RecipeHistory.create(
          recipeTitle: recipeInfo['title'] ?? 'Generated Recipe',
          recipeCategory: recipeInfo['category'] ?? 'General',
          type: _selectedPreset != null ? RecipeHistoryType.presetGeneration : RecipeHistoryType.reverseRecipe,
          originalIngredients: {'ingredients': currentIngredients},
          optimizedIngredients: {'ingredients': _reverseRecipeResult!.generatedIngredients},
          environmentalConditions: _getEnvironmentalConditions(),
          beforeStatus: beforeStatus,
          afterStatus: afterStatus,
          optimizationNotes: _reverseRecipeResult!.optimizationNotes,
          metadata: {
            'achievementScore': _reverseRecipeResult!.achievementScore,
            'bakersPercentages': _reverseRecipeResult!.bakersPercentages,
            'presetId': _selectedPreset?.id,
          },
        );
      }

      if (history != null) {
        await RecipeHistoryService.instance.addHistory(history);
      }
    } catch (e) {
      print('히스토리 저장 오류: $e');
      // 히스토리 저장 실패해도 메인 기능에는 영향 없도록 함
    }
  }

