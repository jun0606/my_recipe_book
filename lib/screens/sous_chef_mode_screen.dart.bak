      padding: const EdgeInsets.all(16.0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _buildTargetHeader(),
          const SizedBox(height: 16),
          _buildTargetSliders(),
          const SizedBox(height: 16),
          _buildTargetPreview(),
          const SizedBox(height: 16),
          _buildGenerateFromTargetButton(),
          // 시스템 바에 가려지지 않도록 충분한 여백 추가
          const SizedBox(height: 100),
        ],
      ),
    );
  }

