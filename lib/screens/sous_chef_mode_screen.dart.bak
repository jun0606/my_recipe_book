class SousChefModeScreen extends StatefulWidget {
  final Map<String, dynamic> recipeData;

  const SousChefModeScreen({
    super.key,
    required this.recipeData,
  });

  @override
  State<SousChefModeScreen> createState() => _SousChefModeScreenState();
}

class _SousChefModeScreenState extends State<SousChefModeScreen>
    with SingleTickerProviderStateMixin {
  late TabController _tabController;
  
  RecipeAnalysisResult? _analysisResult;
  bool _isAnalyzing = true;
  
  ProductStatus? _beforeStatus;
  ProductStatus? _afterStatus;
  
  final _temperatureController = TextEditingController(text: '26');
  final _humidityController = TextEditingController(text: '60');
  final _altitudeController = TextEditingController(text: '0');
  

  
  // 오븐 설정 컨트롤러들
  // 오븐 컨트롤러 제거됨 - 스마트 타이머에 통합
  // 베이킹 타이머 컨트롤러 제거됨 - 스마트 타이머에 통합
  String _selectedOvenType = 'electric';
  String _selectedPanColor = 'light';
  
  Map<String, dynamic>? _optimizationResult;
  bool _isOptimizing = false;
  
  // 발효/오븐 모듈 인스턴스
  final FermentationModule _fermentationModule = FermentationModule();
  final OvenCharacteristicsModule _ovenModule = OvenCharacteristicsModule();

  ReverseRecipeResult? _reverseRecipeResult;
  RecipePreset? _selectedPreset;
  
  int _recipeDevelopmentTabIndex = 0;
  
  // 피드백 시스템 관련 변수들
  FavoritePreset? _selectedFavoritePreset;
  bool _showFeedbackSection = false;
  bool _feedbackCompleted = false;

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: 3, vsync: this);
    

    
    _performInitialAnalysis();
  }

  @override
  void dispose() {
    _tabController.dispose();
    _temperatureController.dispose();
    _humidityController.dispose();
    _altitudeController.dispose();
    
    // 오븐 컨트롤러들 정리

    // 오븐 컨트롤러 제거됨
    // 베이킹 타이머 컨트롤러 제거됨
    
    super.dispose();
  }

  void _performInitialAnalysis() async {
    try {
      setState(() {
        _isAnalyzing = true;
      });

      final ingredients = widget.recipeData['currentIngredients'] as List<Map<String, dynamic>>;
      final recipeInfo = widget.recipeData['recipeInfo'] as Map<String, dynamic>? ?? {};
      final recipeTitle = recipeInfo['title'] as String? ?? '';
      
      // 환경 변수 수집
      final temperature = double.tryParse(_temperatureController.text) ?? 25.0;
      final humidity = double.tryParse(_humidityController.text) ?? 65.0;
      final altitude = double.tryParse(_altitudeController.text) ?? 0.0;
      
      // 개선된 분석 실행 (제목 + 환경 변수 포함)
      final analysisResult = RealTimeRecipeAnalyzer.analyzeIngredients(
        ingredients,
        recipeTitle: recipeTitle.isNotEmpty ? recipeTitle : null,
        ovenCapacityLiters: 30.0, // 기본 오븐 용량
        environmentTemperature: temperature,
        environmentHumidity: humidity,
        altitude: altitude,
      );
      
      final beforeStatus = ProductStatusGenerator.generateStatus(
        analysisResult: analysisResult,
        bakingContext: widget.recipeData['bakingContext'] as Map<String, dynamic>? ?? {},
        environmentalConditions: {
          'temperature': 26.0,
          'humidity': 60.0,
          'altitude': 0.0,
          'ovenType': 'electric',
        },
      );
      
      setState(() {
        _analysisResult = analysisResult;
        _beforeStatus = beforeStatus;
        _isAnalyzing = false;
      });
    } catch (e) {
      setState(() {
        _isAnalyzing = false;
      });
      _showErrorDialog('레시피 분석 중 오류가 발생했습니다: $e');
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Sous Chef Mode'),
        backgroundColor: Colors.orange.shade600,
        foregroundColor: Colors.white,
        bottom: TabBar(
          controller: _tabController,
          labelColor: Colors.white,
          unselectedLabelColor: Colors.white70,
          indicatorColor: Colors.white,
          tabs: const [
            Tab(icon: Icon(Icons.analytics), text: 'Analysis'),
            Tab(icon: Icon(Icons.science), text: 'Recipe Dev'),
            Tab(icon: Icon(Icons.auto_awesome), text: 'Smart Presets'),
          ],
        ),
        actions: [
          IconButton(
            icon: const Icon(Icons.history),
            onPressed: _showHistory,
            tooltip: '히스토리',
          ),
          if (_optimizationResult != null || _reverseRecipeResult != null)
            TextButton(
              onPressed: _applyAndReturn,
              child: const Text('Apply', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
            ),
        ],
      ),
      body: TabBarView(
        controller: _tabController,
        children: [
          _buildAnalysisTab(),
          _buildRecipeDevelopmentTab(),
          _buildSmartPresetsTab(),
        ],
      ),
    );
  } 
 Widget _buildAnalysisTab() {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16.0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _buildRecipeHeader(),
          const SizedBox(height: 16),
          _buildAnalysisSection(),
          const SizedBox(height: 16),
          _buildEnvironmentSection(),
          const SizedBox(height: 16),
          _buildOptimizeButton(),
          if (_afterStatus != null) ...[
            const SizedBox(height: 16),
            _buildComparisonSection(),
          ],
          // 시스템 바에 가려지지 않도록 충분한 여백 추가
          const SizedBox(height: 100),
        ],
      ),
    );
  }

  Widget _buildRecipeDevelopmentTab() {
    return Column(
      children: [
        Container(
          margin: const EdgeInsets.all(16.0),
          decoration: BoxDecoration(
            color: Colors.grey.shade100,
            borderRadius: BorderRadius.circular(12),
          ),
          child: Row(
            children: [
              Expanded(child: _buildSubTabButton('Target', Icons.tune, 0)),
              Expanded(child: _buildSubTabButton('Preset', Icons.bookmark, 1)),
              Expanded(child: _buildSubTabButton('Text', Icons.auto_awesome, 2)),
            ],
          ),
        ),
        Expanded(
          child: IndexedStack(
            index: _recipeDevelopmentTabIndex,
            children: [
              _buildTargetBasedTab(),
              _buildPresetBasedTab(),
              _buildTextBasedTab(),
            ],
          ),
        ),
      ],
    );
  }

  Widget _buildSubTabButton(String title, IconData icon, int index) {
    final isSelected = _recipeDevelopmentTabIndex == index;
    return GestureDetector(
      onTap: () => setState(() => _recipeDevelopmentTabIndex = index),
      child: Container(
        padding: const EdgeInsets.symmetric(vertical: 12, horizontal: 8),
        decoration: BoxDecoration(
          color: isSelected ? Colors.orange.shade600 : Colors.transparent,
          borderRadius: BorderRadius.circular(10),
        ),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Icon(icon, size: 20, color: isSelected ? Colors.white : Colors.grey.shade600),
            const SizedBox(height: 4),
            Text(
              title, 
              style: TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: isSelected ? Colors.white : Colors.grey.shade600), 
              textAlign: TextAlign.center,
              overflow: TextOverflow.ellipsis,
            ),
          ],
        ),
      ),
    );
  } 
 Widget _buildRecipeHeader() {
    final recipeInfo = widget.recipeData['recipeInfo'] as Map<String, dynamic>;
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Icon(Icons.restaurant_menu, color: Colors.orange.shade600),
                const SizedBox(width: 8),
                Expanded(
                  child: Text(
                    recipeInfo['title'] ?? 'Recipe', 
                    style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                    overflow: TextOverflow.ellipsis,
                    maxLines: 2,
                  )
                ),
              ],
            ),
            const SizedBox(height: 8),
            Text(
              'Category: ${recipeInfo['category'] ?? 'General'}', 
              style: TextStyle(fontSize: 14, color: Colors.grey.shade600),
              overflow: TextOverflow.ellipsis,
            ),
          ],
        ),
      ),
    );
  }

