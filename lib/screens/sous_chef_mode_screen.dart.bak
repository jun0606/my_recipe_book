  /// 분석 결과 행을 생성하는 헬퍼 메서드 (아이콘 포함)
  Widget _buildAnalysisRowWithIcon(IconData icon, String label, String value, Color iconColor) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 2),
      child: Row(
        children: [
          Icon(icon, size: 12, color: iconColor),
          const SizedBox(width: 6),
          Text(
            '$label: ',
            style: TextStyle(fontSize: 10, color: Colors.grey.shade600),
          ),
          Expanded(
            child: Text(
              value,
              style: const TextStyle(fontSize: 10, fontWeight: FontWeight.w600),
              overflow: TextOverflow.ellipsis,
            ),
          ),
        ],
      ),
    );
  }

  /// 발효 설정 변경 시 호출되는 리스너
  void _onFermentationSettingsChanged() {
    // 발효 설정이 변경되면 상태 업데이트
    if (mounted) {
      setState(() {
        // UI 업데이트를 위한 setState
      });
      
      // 발효 설정 유효성 검증
      _validateFermentationSettings();
      
      // 디버그 정보 출력
      print('🔧 발효 설정 변경됨:');
      print('   - 온도: ${(double.tryParse(_temperatureController.text) ?? 26.0) + 2.0}°C (자동 계산)');
      print('   - 습도: ${(double.tryParse(_humidityController.text) ?? 60.0) + 10.0}% (자동 계산)');
      print('   - 시간: 90분 (기본값)');
    }
  }

  /// 발효 설정 유효성 검증
  void _validateFermentationSettings() {
    final temp = (double.tryParse(_temperatureController.text) ?? 26.0) + 2.0;
    final humidity = (double.tryParse(_humidityController.text) ?? 60.0) + 10.0;
    final time = 90.0;
    
    // 온도 범위 검증 (20-35°C)
    if (temp != null && (temp < 20 || temp > 35)) {
      print('⚠️ 발효 온도 경고: ${temp}°C (권장: 20-35°C)');
    }
    
    // 습도 범위 검증 (60-85%)
    if (humidity != null && (humidity < 60 || humidity > 85)) {
      print('⚠️ 발효 습도 경고: ${humidity}% (권장: 60-85%)');
    }
    
    // 시간 범위 검증 (30-480분)
    if (time != null && (time < 30 || time > 480)) {
      print('⚠️ 발효 시간 경고: ${time}분 (권장: 30-480분)');
    }
  }

  /// 스마트 타이머 버튼 텍스트 반환
  String _getSmartTimerButtonText() {
    final temp = (double.tryParse(_temperatureController.text) ?? 26.0) + 2.0;
    final humidity = (double.tryParse(_humidityController.text) ?? 60.0) + 10.0;
    final time = 90.0;
    
    if (temp != null && humidity != null && time != null) {
      return '스마트\n타이머\n✓';
    } else {
      return '스마트\n타이머';
    }
  }

  /// 스마트 타이머 버튼 색상 반환
  Color _getSmartTimerButtonColor() {
    final temp = (double.tryParse(_temperatureController.text) ?? 26.0) + 2.0;
    final humidity = (double.tryParse(_humidityController.text) ?? 60.0) + 10.0;
    final time = 90.0;
    
    if (temp != null && humidity != null && time != null) {
      // 모든 값이 유효한 범위인지 확인
      final tempValid = temp >= 20 && temp <= 35;
      final humidityValid = humidity >= 60 && humidity <= 85;
      final timeValid = time >= 30 && time <= 480;
      
      if (tempValid && humidityValid && timeValid) {
        return Colors.green.shade600; // 모든 설정이 유효
      } else {
        return Colors.orange.shade600; // 일부 설정이 범위를 벗어남
      }
    } else {
      return Colors.purple.shade600; // 기본 색상
    }
  }

  /// 스마트 타이머 표시 (발효 + 오븐 기능 통합)
  void _showSmartTimer() {
    final environmentTemp = double.tryParse(_temperatureController.text) ?? 26.0;
    final environmentHumidity = double.tryParse(_humidityController.text) ?? 65.0;
    final altitude = double.tryParse(_altitudeController.text) ?? 0.0;
    
    // 기본 발효 설정값 (자동 계산)
    final fermentationTemp = environmentTemp + 2.0; // 환경온도 + 2도
    final fermentationHumidity = environmentHumidity + 10.0; // 환경습도 + 10%
    final fermentationTime = 90.0; // 기본 90분
    
    // 기본 오븐 설정값 (자동 계산)
    final ovenTemp = 180.0; // 기본 180도
    final ovenTime = 25.0; // 기본 25분
    
    print('🚀 스마트 타이머 시작 (발효 + 오븐 통합):');
    print('   🌡️ 환경 조건:');
    print('      - 온도: ${environmentTemp}°C');
    print('      - 습도: ${environmentHumidity}%');
    print('      - 고도: ${altitude}m');
    print('   🧑‍🍳 발효 설정 (자동 계산):');
    print('      - 온도: ${fermentationTemp}°C');
    print('      - 습도: ${fermentationHumidity}%');
    print('      - 시간: ${fermentationTime}분');
    print('   🔥 오븐 설정 (자동 계산):');
    print('      - 온도: ${ovenTemp}°C');
    print('      - 시간: ${ovenTime}분');
    
    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (context) => FermentationTimerWidget(
        environmentTemperature: environmentTemp,
        environmentHumidity: environmentHumidity,
        altitude: altitude,
        // 발효 설정 값들 자동 계산하여 전달
        targetFermentationTemperature: fermentationTemp,
        targetFermentationHumidity: fermentationHumidity,
        targetFermentationTime: fermentationTime,
        onTimerComplete: () {
          Navigator.of(context).pop();
          
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(
              content: Text('🎉 베이킹이 완료되었습니다! 맛있게 드세요.'),
              backgroundColor: Colors.green,
              duration: Duration(seconds: 5),
            ),
          );
          
          // 베이킹 완료 시 최종 분석
          _performInitialAnalysis();
        }, 
      ),
    );
  }  /// 발효 설정 탭
  Widget _buildFermentationSettingsTab(ScrollController scrollController) {
    return SingleChildScrollView(
      controller: scrollController,
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // 발효 단계 선택
          _buildSectionCard(
            title: '발효 단계',
            icon: Icons.timeline,
            child: Column(
              children: [
                _buildRadioOption('1차 발효', '1차', '1차'),
                _buildRadioOption('분할 후 휴지', '분할후', '분할후'),
                _buildRadioOption('성형 후 발효', '성형후', '성형후'),
                _buildRadioOption('최종 발효', '최종', '최종'),
                _buildRadioOption('오버나이트', '오버나이트', '오버나이트'),
              ],
            ),
          ),
          const SizedBox(height: 16),
          
          // 발효 방법 선택
          _buildSectionCard(
            title: '발효 방법',
            icon: Icons.thermostat,
            child: Column(
              children: [
                _buildRadioOption('실온 발효', '실온', '실온'),
                _buildRadioOption('발효기 사용', '발효기', '발효기'),
                _buildRadioOption('냉장 발효', '냉장', '냉장'),
                _buildRadioOption('따뜻한 곳', '따뜻한곳', '따뜻한곳'),
              ],
            ),
          ),
          const SizedBox(height: 16),
          
          // 환경 설정
          _buildSectionCard(
            title: '환경 설정',
            icon: Icons.tune,
            child: Column(
              children: [
                _buildSliderSetting('온도', '°C', 15, 40, 
                  (double.tryParse(_temperatureController.text) ?? 26.0) + 2.0,
                  (value) => {}, // 자동 계산으로 변경됨
                ),
                _buildSliderSetting('습도', '%', 50, 90, 
                  (double.tryParse(_humidityController.text) ?? 60.0) + 10.0,
                  (value) => {}, // 자동 계산으로 변경됨
                ),
                _buildSliderSetting('목표 시간', '분', 30, 480, 
                  90.0,
                  (value) => {}, // 자동 계산으로 변경됨
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

