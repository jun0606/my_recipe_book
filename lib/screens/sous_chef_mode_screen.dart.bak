  Widget _buildEnvironmentSection() {
    return Column(
      children: [
        // 기본 환경 설정
        Card(
          child: Padding(
            padding: const EdgeInsets.all(16.0),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Icon(Icons.thermostat, color: Colors.green.shade600),
                    const SizedBox(width: 8),
                    const Text('기본 환경', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
                  ],
                ),
                const SizedBox(height: 16),
                LayoutBuilder(
                  builder: (context, constraints) {
                    if (constraints.maxWidth < 400) {
                      return Column(
                        children: [
                          TextField(
                            controller: _temperatureController,
                            keyboardType: TextInputType.number,
                            decoration: InputDecoration(
                              labelText: '실내 온도 (°C)',
                              border: const OutlineInputBorder(),
                              prefixIcon: Icon(Icons.thermostat, color: Colors.orange.shade600),
                            ),
                          ),
                          const SizedBox(height: 12),
                          TextField(
                            controller: _humidityController,
                            keyboardType: TextInputType.number,
                            decoration: InputDecoration(
                              labelText: '실내 습도 (%)',
                              border: const OutlineInputBorder(),
                              prefixIcon: Icon(Icons.water_drop, color: Colors.blue.shade600),
                            ),
                          ),
                          const SizedBox(height: 12),
                          TextField(
                            controller: _altitudeController,
                            keyboardType: TextInputType.number,
                            decoration: InputDecoration(
                              labelText: '고도 (m)',
                              border: const OutlineInputBorder(),
                              prefixIcon: Icon(Icons.landscape, color: Colors.green.shade600),
                            ),
                          ),
                        ],
                      );
                    } else {
                      return Column(
                        children: [
                          Row(
                            children: [
                              Expanded(
                                child: TextField(
                                  controller: _temperatureController,
                                  keyboardType: TextInputType.number,
                                  decoration: InputDecoration(
                                    labelText: '실내 온도 (°C)',
                                    border: const OutlineInputBorder(),
                                    prefixIcon: Icon(Icons.thermostat, color: Colors.orange.shade600),
                                  ),
                                ),
                              ),
                              const SizedBox(width: 12),
                              Expanded(
                                child: TextField(
                                  controller: _humidityController,
                                  keyboardType: TextInputType.number,
                                  decoration: InputDecoration(
                                    labelText: '실내 습도 (%)',
                                    border: const OutlineInputBorder(),
                                    prefixIcon: Icon(Icons.water_drop, color: Colors.blue.shade600),
                                  ),
                                ),
                              ),
                            ],
                          ),
                          const SizedBox(height: 12),
                          TextField(
                            controller: _altitudeController,
                            keyboardType: TextInputType.number,
                            decoration: InputDecoration(
                              labelText: '고도 (m)',
                              border: const OutlineInputBorder(),
                              prefixIcon: Icon(Icons.landscape, color: Colors.green.shade600),
                            ),
                          ),
                        ],
                      );
                    }
                  },
                ),
              ],
            ),
          ),
        ),
        const SizedBox(height: 16),
        

        

      ],
    );
  }

}
              },
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildOptimizeButton() {
    return SizedBox(
      width: double.infinity,
      child: ElevatedButton(
        onPressed: _isOptimizing ? null : _performOptimization,
        style: ElevatedButton.styleFrom(backgroundColor: Colors.green.shade600, foregroundColor: Colors.white, padding: const EdgeInsets.symmetric(vertical: 16)),
        child: _isOptimizing
            ? const Row(
                mainAxisAlignment: MainAxisAlignment.center,
                mainAxisSize: MainAxisSize.min,
                children: [
                  SizedBox(
                    width: 20, 
                    height: 20, 
                    child: CircularProgressIndicator(
                      strokeWidth: 2, 
                      valueColor: AlwaysStoppedAnimation<Color>(Colors.white)
                    )
                  ),
                  SizedBox(width: 8),
                  Flexible(child: Text('Optimizing...', overflow: TextOverflow.ellipsis)),
                ]
              )
            : const Text('Apply Environment & Optimize'),
      ),
    );
  }

  Widget _buildComparisonSection() {
    if (_beforeStatus == null || _afterStatus == null) return const SizedBox.shrink();
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Icon(Icons.compare_arrows, color: Colors.purple.shade600),
                const SizedBox(width: 8),
                const Text('Before / After Comparison', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
              ],
            ),
            const SizedBox(height: 16),
            Container(
              decoration: BoxDecoration(
                border: Border.all(color: Colors.grey.shade300),
                borderRadius: BorderRadius.circular(8),
              ),
              child: Column(
                children: [
                  // 헤더
                  Container(
                    padding: const EdgeInsets.all(12),
                    decoration: BoxDecoration(
                      color: Colors.grey.shade100,
                      borderRadius: const BorderRadius.only(
                        topLeft: Radius.circular(8),
                        topRight: Radius.circular(8),
                      ),
                    ),
                    child: const Row(
                      children: [
                        Expanded(
                          flex: 2,
                          child: Text(
                            '특성',
                            style: TextStyle(fontWeight: FontWeight.bold),
                          ),
                        ),
                        Expanded(
                          flex: 3,
                          child: Text(
                            'Before',
                            textAlign: TextAlign.center,
                            style: TextStyle(fontWeight: FontWeight.bold),
                          ),
                        ),
                        Expanded(
                          flex: 3,
                          child: Text(
                            'After',
                            textAlign: TextAlign.center,
                            style: TextStyle(fontWeight: FontWeight.bold),
                          ),
                        ),
                      ],
                    ),
                  ),
                  // 데이터 행들
                  _buildComparisonRow('식감', _beforeStatus!.textureProfile.primary, _afterStatus!.textureProfile.primary),
                  _buildComparisonRow('풍미', _beforeStatus!.flavorProfile.primary.join(', '), _afterStatus!.flavorProfile.primary.join(', ')),
                  _buildComparisonRow('외관', _beforeStatus!.appearanceProfile.crustColor, _afterStatus!.appearanceProfile.crustColor),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

