            child: Column(
              children: [
                _buildCheckpointItem('30분 후', '폴딩 실시', false),
                _buildCheckpointItem('1시간 후', '부피 1.3배 확인', false),
                _buildCheckpointItem('1시간 45분', '부피 1.7배 확인', false),
                _buildCheckpointItem('2시간 15분', '최종 발효 완료', false),
